# The private folder: the database, keys, backups. Never tracked.
# `npm run check:public` fails if anything under it ever is.
/private/

# Keys, wherever they are.
.env
.env.*
!.env.example

# Databases.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

node_modules/
npm-debug.log*
.DS_Store
Thumbs.db

# The throwaway home `npm run demo` builds.
/.demo/

# A release folder's commit, written by deploy/deploy.sh (src/web/ready.js reads it).
/REVISION
# The release folders on the server (deploy/deploy.sh), inside the clone, and the link to the live one.
/releases/
/current
/current.next
