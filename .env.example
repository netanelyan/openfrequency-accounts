# openfrequency-accounts: every variable the service reads.
#
# Copy this file to $OF_HOME/.env (./private/.env by default; `npm run init-private`
# does it) and fill it in there. Never put a value in this file itself.

# ---------- where the private data lives ------------------------------------

# The private folder: the database, backups, this .env. Default ./private (inside
# the checkout, gitignored). A relative path is resolved against the repository root.
OF_HOME=

# ---------- the two listeners ------------------------------------------------

# The public site, behind Caddy, on 127.0.0.1. Default 4740 (Teder has 4700,
# Toran 4710, the website's lead endpoint 4720 and its dev preview 4730).
PORT=
# /internal/session, /internal/owner-phone*, /internal/entitlement (the paywall) and
# /internal/notify (product emails) for Teder and Toran, on 127.0.0.1, never proxied.
# Default 4741.
INTERNAL_PORT=
# Where /admin reaches Toran's internal routes on this machine, for the operator's
# dashboard: GET /internal/ops and POST /internal/ops/<kind>/<id>/<action> (Toran's
# docs/operator.md, section 4), with OF_INTERNAL_TOKEN below. Default
# http://127.0.0.1:4710. While Toran does not answer, its sections of /admin say so
# and the rest of the page works. /admin/toran/ (Toran's operator pages) is proxied
# to the same address, superadmin only.
OF_TORAN_INTERNAL=
# Where /setup reaches Teder's internal routes on this machine: GET /internal/setup, each
# product's checklist for a workspace (docs/setup.md), with OF_INTERNAL_TOKEN below. Default
# http://127.0.0.1:4700. Toran's is asked at OF_TORAN_INTERNAL above. A deleted workspace's
# data is deleted at both, POST /internal/workspaces/<id>/delete.
OF_TEDER_INTERNAL=
# The name the public site answers to. Set on the server: the site then insists
# on HTTPS through the proxy and sets the cookie for .openfrequency.co.il. The product
# emails' link to /notifications is made from it too.
PUBLIC_HOST=

# ---------- public sign-up (docs/setup.md) -----------------------------------

# 1 opens /signup: a business opens its own account, confirmed by an emailed link or by
# Google. Anything else (unset by default): /signup says it opens soon, with a link to
# openfrequency.co.il/join, and refuses every POST.
OF_SIGNUP=
# Who hears of each confirmed sign-up, each subscription cancelled online (and taken
# back), and each deleted workspace: comma-separated addresses, each sent a short email
# (who, which business, which products, when, a link to it on /admin). Unset, no notice.
# A notice that fails to send is logged and never holds up what the customer did.
OF_SIGNUP_NOTIFY=
# The products /signup offers, comma-separated (unknown names are ignored). Default
# teder,toran. A product left out shows on the form as coming soon, its box off, and is
# refused; while Meta has not approved WhatsApp, set teder. The superadmin's console
# opens any product either way.
OF_SIGNUP_PRODUCTS=
# The payment hook: set it to the card-clearing provider's name once one is connected.
# The products are behind a paywall either way (docs/setup.md): a product opens once a
# recorded payment covers today, or the superadmin marks it complimentary on /admin.
# Unset, payment is recorded by hand on /admin, the setup page's payment step says the
# online payment opens soon and leads to us (OF_SUPPORT_WA below), and the home page
# shows no next charge.
OF_BILLING_PROVIDER=

# ---------- the owner line ---------------------------------------------------

# Toran's owner line: the WhatsApp number a customer sends their link code to, in
# international digits (972500000100, no + and no leading 0). The same number as
# TORAN_ASSISTANT_WA in Toran's .env. Unset, the home page still makes the code and
# says the number is not set yet, without the WhatsApp button.
OF_ASSISTANT_WA=

# ---------- secrets ----------------------------------------------------------

# Teder and Toran send it as a bearer token to /internal/session, and /admin sends
# it to Toran's /internal/ops. 32+ characters, the same value in every service.
OF_INTERNAL_TOKEN=
# Signs CSRF tokens. 32+ characters.
SESSION_SECRET=

# ---------- email ------------------------------------------------------------

# Resend: magic links and invites. Without a key, emails are written to
# $OF_HOME/data/outbox/ instead of sent.
RESEND_API_KEY=
# The sender, on a domain verified in Resend.
MAIL_FROM=
# Where a reply to one of our emails lands: your own inbox.
MAIL_REPLY_TO=

# ---------- sign in with Google ---------------------------------------------

# An OAuth client of type "Web application" in Google Cloud (APIs & Services >
# Credentials), with https://accounts.openfrequency.co.il/auth/google/callback as an
# authorised redirect URI (and http://localhost:4740/auth/google/callback to try it
# locally). Both unset, the login and invite pages show the emailed link only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- support ----------------------------------------------------------

# Our WhatsApp, international digits (972...), where a customer reaches us from their
# home page: "write to us" when a question comes up, when their workspace already
# has its 3 people and they want more, and, while no payment provider is connected, to
# pay (the setup page's payment step); those buttons open with the message written.
# Unset, the pages tell them to answer one of our emails, and the payment step leads to
# https://openfrequency.co.il/join.
OF_SUPPORT_WA=
